{
  "manifest_version": 3,
  "name": "YouTube Comment Filter",
  "version": "1.0.0",
  "description": "Hide unwanted YouTube comments locally using keywords, usernames, links and spam heuristics.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {"default_popup": "popup.html", "default_title": "YouTube Comment Filter"},
  "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}],
  "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"},
  "minimum_chrome_version": "111"
}
